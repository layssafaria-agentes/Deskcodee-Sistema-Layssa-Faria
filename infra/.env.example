# Template de variáveis de ambiente do projeto Layssa Faria / DeskcommCRM.
# Este arquivo é seguro para commitar (não tem valores reais).
# Copie para `.env` (que é ignorado pelo Git) e preencha com os valores reais.

# ── App ──────────────────────────────────────────────────────────────────
APP_NAME="Clínica Dra. Layssa Faria"
APP_LOCALE=pt-BR
# URL pública do app. Enquanto não há domínio, usar a URL do Cloudflare Tunnel
# (ex: https://algo-aleatorio.trycloudflare.com). Trocar quando tiver domínio real.
NEXT_PUBLIC_APP_URL=

# ── Supabase (criar projeto grátis em https://supabase.com) ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── IA (OpenAI) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
AI_BUDGET_ENFORCEMENT=on

# ── WhatsApp (WAHA) ──────────────────────────────────────────────────────
WAHA_API_BASE_URL=
WAHA_API_KEY=
WAHA_HMAC_SECRET=

# ── Google Calendar (agendamento) ────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── LGPD ──────────────────────────────────────────────────────────────────
LGPD_DPO_EMAIL=

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────
# Token do túnel nomeado (gerado depois com `cloudflared tunnel create`).
# Deixe em branco enquanto estiver usando o túnel temporário (trycloudflare.com).
CLOUDFLARE_TUNNEL_TOKEN=
