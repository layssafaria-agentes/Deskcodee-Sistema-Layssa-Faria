# Um domínio, duas superfícies: as APIs públicas do Supabase seguem para o
# Envoy privado; todo o restante segue para o app. Studio e Postgres não são
# publicados.
#
# TLS manual (2026-09-26): atrás de Cloudflare Tunnel o domínio nunca aponta
# para o IP real da VPS, então nem o desafio tls-alpn-01 nem o http-01 do
# Let's Encrypt conseguem validar (a Cloudflare responde no lugar da origem).
# Em vez de brigar com o ACME automático, usamos um certificado autoassinado
# de longa duração (gerado uma vez, fora do Git, em
# /var/lib/docker/volumes/deskcommcrm_caddy-data/_data/manual-tls/) — o túnel
# já está com "No TLS Verify" ligado, então a confiança do certificado não
# importa para esse salto interno; quem valida de verdade é a Cloudflare, na
# borda, com o certificado dela própria.

{
	auto_https off
}

:443 {
	tls /data/manual-tls/cert.pem /data/manual-tls/key.pem
	encode gzip

	route {
		# O webhook global do WAHA só pode ser chamado pela rede interna.
		@waha_global path /api/v1/webhooks/waha
		respond @waha_global 403

		# Superfícies públicas necessárias aos SDKs Supabase no navegador.
		@supabase path /auth/v1* /rest/v1* /realtime/v1* /storage/v1* /functions/v1* /graphql/v1*
		reverse_proxy @supabase supabase-envoy:8000

		@agentrun path /api/internal/agents/run*
		reverse_proxy @agentrun app:3000 {
			transport http {
				read_timeout 320s
				write_timeout 320s
			}
		}

		reverse_proxy app:3000
	}
}
